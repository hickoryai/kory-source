        {
          "path": ".github/workflows/authz-gauntlet-panel.yml",
          "line": 274,
          "severity": "BLOCKER",
          "category": "security",
          "title": "The permitted Git commands can write files and execute code",
          "body": "These command prefixes do not enforce the promised read-only boundary. An agent influenced by attacker-controlled repository content can run `git log -1 --format=... --output=.git/config` to write Git configuration, then invoke `git diff --ext-diff` to execute a configured external command. This permits arbitrary code execution in the lens job, which receives the Anthropic API key and has `id-token: write`. Restricting executable names to Git subcommands does not restrict their side effects.",
          "confidence": 0.93,
          "source_pass": "security"
        },
        {
          "path": ".github/scripts/authz_gauntlet_checks.py",
          "line": 46,
          "severity": "WARNING",
          "category": "bug",
          "title": "Keep raw index predicate matching within one SQL statement",
          "body": "The `.*?` before `WHERE` crosses semicolons, so a valid migration string such as `CREATE INDEX ix ON t (id); DELETE FROM t WHERE expires_at < now();` is reported as an invalid index predicate. I verified that this regex captures the DELETE predicate. Since migration findings fail the blocking checks job, this prevents valid authz migrations from merging. Bound the index match to its statement and inspect every index statement in a string.",
          "confidence": 1.0,
          "source_pass": "main"
        }
      ],
