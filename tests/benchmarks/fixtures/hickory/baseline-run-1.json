        },
        {
          "path": "hickory-ui/backend/app/services/ccc_worklist.py",
          "line": 2950,
          "severity": "WARNING",
          "category": "bug",
          "title": "Probe historical replies when an open contact changes identity",
          "body": "`_build_open_contact_rows` replaces the stored identity with the live contact's identity, but this probe only handles an old refresh. If a 40-day-old contact moves to a person who received a callback 20 days ago, a recent refresh and a 14-day window exclude that callback from both clearing paths. The contact incorrectly remains unanswered. Detect changes to tenant, person, or universal identity and request a backward probe, as the lead arm already does for moved people.",
          "confidence": 0.98,
          "source_pass": "main"
        },
        {
          "path": "scripts/cleanup_ccc_backlog.py",
          "line": 91,
          "severity": "WARNING",
          "category": "bug",
          "title": "Check freshness across all selected brands",
          "body": "`max(computed_at)` accepts the entire selection when any selected brand is fresh. Since `refresh_open_items` supports replacing individual brands, refreshing one brand allows cleanup to mutate another brand's stale backlog despite the 36-hour guard. Require every selected brand with rows to have a fresh snapshot before permitting writes.",
          "confidence": 0.97,
          "source_pass": "main"
        }
      ],
